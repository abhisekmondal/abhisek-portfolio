API_PORT=4000
WEB_PORT=8080
CORS_ORIGIN=http://localhost:3000
JSON_LIMIT=512kb
RATE_LIMIT_MAX=300
TRUST_PROXY=false
IMPORT_FILE_LIMIT_BYTES=6291456

# Local/dev PostgreSQL. Use DATABASE_URL in hosted environments.
PGHOST=localhost
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=postgres
PGSSLMODE=disable
DATABASE_URL=

REACT_APP_API_URL=http://localhost:4000
JWT_SECRET=replace-with-a-long-random-secret

# Separate frontend/API deployment
# REACT_APP_API_URL is the browser-visible API URL used by the frontend build.
REACT_APP_API_URL=http://localhost:4000
# DATABASE_URL=postgresql://user:password@host:5432/database
# PGSSLMODE=require
