API_PORT=4000
WEB_PORT=8080
CORS_ORIGIN=http://localhost:8080
JSON_LIMIT=512kb
RATE_LIMIT_MAX=300
TRUST_PROXY=false
IMPORT_FILE_LIMIT_BYTES=6291456
PASSWORD_RESET_TOKEN_MINUTES=30
PASSWORD_RESET_EXPOSE_TOKEN=true
APP_URL=http://localhost:8080
MAIL_FROM="Resume Builder <no-reply@your-domain.com>"
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-brevo-smtp-login
SMTP_PASS=your-brevo-smtp-key

# Existing docker-compose.yml expects an external PostgreSQL database.
# For local Docker Desktop testing against a PostgreSQL server on the host:
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/postgres
PGSSLMODE=disable

REACT_APP_API_URL=http://localhost:4000
JWT_SECRET=replace-with-a-long-random-secret-for-local-docker
